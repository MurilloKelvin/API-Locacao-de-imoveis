class DbContext <<framework>>
class ClienteController <<controller>>
class ImoveisController <<controller>>
class ReservaController <<controller>>
class HealthController <<controller>>
class AppDbContext
class CpfJaCadastradoException
class EmailJaCadastradoException
class RecursoNaoEncontradoException
ClienteController -down-|> ControllerBase
