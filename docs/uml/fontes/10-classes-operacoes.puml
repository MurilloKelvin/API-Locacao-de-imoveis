@startuml
!include estilo.iuml
!pragma layout smetana
title Servicos e contratos da aplicacao
package Application {
 class ClienteService <<service>> {
  +CriarClienteAsync(...) : Task<Guid>
  +ObterClientePorIdAsync(...) : Task<ClienteResponse>
  +ObterClientePorCpfAsync(...) : Task<ClienteResponse>
  +ObterTodosClientesAsync(filtro: ListarClientesRequest, token: CancellationToken) : Task<List<ClienteResponse>>
  +AtualizarClienteAsync(...) : Task
  +AtivarClienteAsync(...) : Task
  +InativarClienteAsync(...) : Task
 }
 class ImovelService <<service>> {
  +CriarImovelAsync(...) : Task<Guid>
  +ListarImoveisAsync(...) : Task<List<ImovelResponse>>
  +ListarImoveisDisponiveisAsync(...) : Task<List<ImovelResponse>>
  +AtualizarImovelAsync(...) : Task
  +AlterarStatusImovelAsync(...) : Task
 }
 class ReservaService <<service>> {
  +CriarReservaAsync(...) : Task<Guid>
  +ObterTodasReservasAsync(filtro: ListarReservasRequest, token: CancellationToken) : Task<List<ReservaResponse>>
  +ObterReservaPorIdAsync(...) : Task<ReservaResponse>
  +ConfirmarReservaAsync(...) : Task
  +ConcluirReservaAsync(...) : Task
  +CancelarReservaAsync(...) : Task
 }
 interface IClienteRepository {
  +ObterTodosClientesAsync(filtro: ListarClientesRequest, token: CancellationToken) : Task<List<Cliente>>
 }
 interface IImovelRepository
 interface IReservaRepository {
  +ObterTodasReservasAsync(filtro: ListarReservasRequest, token: CancellationToken) : Task<List<Reserva>>
 }
}
ClienteService --> IClienteRepository
ImovelService --> IImovelRepository
ImovelService --> IReservaRepository
ReservaService --> IClienteRepository
ReservaService --> IImovelRepository
ReservaService --> IReservaRepository
@enduml
