@startuml
!include estilo.iuml
hide footbox
autonumber

title Listar reservas com filtros e paginação
actor "Consumidor" as A
participant "controller:\nReservaController" as C
participant "service:\nReservaService" as S
participant "repository:\nReservaRepository" as R
database "SQLite" as B

A -> C : GET /api/v1/reservas?Status=0&Pagina=1
C -> S : ObterTodasReservasAsync(filtro, token)
alt página, tamanho ou status inválido
 S --> C : ArgumentException
 C --> A : 400 ProblemDetails
else filtro válido
 S -> R : ObterTodasReservasAsync(filtro, token)
 R -> B : filtrar cliente/imóvel/status, ordenar entrada/ID, Skip/Take
 B --> R : até TamanhoPagina reservas
 R --> S : lista de Reserva
 S --> C : lista de ReservaResponse
 C --> A : 200 com lista (ou [])
end

note over C,R : Padrão: página 1, tamanho 10; máximo 100.\nSem total de registros na resposta.
@enduml
