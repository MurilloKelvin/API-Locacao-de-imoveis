@startuml
!include estilo.iuml
!pragma layout smetana
title Clientes: dados de entrada e saída
package Application {
  class CriarClienteRequestDTO <<DTO>> {
    +Nome : string {get; set;}
    +Telefone : string {get; set;}
    +Email : string {get; set;}
    +Cpf : string {get; set;}
  }
  class AtualizarClienteRequest <<DTO>> {
    +Nome : string {get; set;}
    +Telefone : string {get; set;}
  }
  class ListarClientesRequest <<DTO>> {
    +Pagina : int = 1 {get; set;}
    +TamanhoPagina : int = 10 {get; set;}
    +Nome : string? {get; set;}
    +Status : ClienteStatus? {get; set;}
  }
  class ClienteResponse <<DTO>> {
    +Id : Guid {get; set;}
    +Nome : string {get; set;}
    +Telefone : string {get; set;}
    +Email : string {get; set;}
    +Cpf : string {get; set;}
    +Status : ClienteStatus {get; set;}
  }
}
package Domain {
  enum ClienteStatus <<enumeration>> {
    Inativo = 0
    Ativo = 1
  }
}
CriarClienteRequestDTO -[hidden]right- AtualizarClienteRequest
AtualizarClienteRequest -[hidden]right- ListarClientesRequest
ListarClientesRequest -[hidden]down- ClienteResponse
ClienteResponse ..right> ClienteStatus : tipo de Status
ListarClientesRequest ..right> ClienteStatus : filtro opcional
@enduml
